version = 1
revision = 2
requires-python = ">=3.12"

[[package]]
name = "app"
version = "0.1.0"
source = { virtual = "." }
dependencies = [
    { name = "a" },
]

[package.dev-dependencies]
dev = [
    { name = "b" },
]

[[package]]
name = "a"
version = "1.0.0"
source = { registry = "https://pypi.org/simple" }
dependencies = [
    { name = "c" },
    { name = "d" },
]

[[package]]
name = "b"
version = "1.0.0"
source = { registry = "https://pypi.org/simple" }
dependencies = [
    { name = "c" },
    { name = "d" },
]

[[package]]
name = "c"
version = "1.0.0"
source = { registry = "https://pypi.org/simple" }

[[package]]
name = "d"
version = "1.0.0"
source = { registry = "https://pypi.org/simple" }
